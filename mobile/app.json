{
  "expo": {
    "name": "Cliper Agent",
    "slug": "cliper-agent",
    "scheme": "cliperagent",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070A",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#07070A"
    },
    "ios": {
      "bundleIdentifier": "com.cliperagent.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cliperagent.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070A"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1",
      "eas": {
        "projectId": ""
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png",
      "name": "Cliper Agent",
      "shortName": "Cliper",
      "themeColor": "#07070A",
      "backgroundColor": "#07070A"
    }
  }
}
