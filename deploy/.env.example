# ─── Cliper Agent production settings ─── copy to deploy/.env and edit ───

# Public address. With a domain pointing at the server you get HTTPS automatically:
#   SITE_ADDRESS=clips.example.com
# Without a domain (testing only):
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com
# The full address people open (needed for connecting social accounts): https://clips.example.com
PUBLIC_URL=

HTTP_PORT=80
HTTPS_PORT=443

# Database (generate with: openssl rand -hex 24)
POSTGRES_USER=cliper
POSTGRES_DB=cliper_agent
POSTGRES_PASSWORD=CHANGE_ME
# Using your own Postgres server instead of the bundled one? Set the full URL here:
# DATABASE_URL=postgresql://user:password@db.example.com:5432/cliper_agent?schema=public

# Auth (generate with: openssl rand -hex 48)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d
# Set false once your team has accounts (the first account is the admin)
ALLOW_SIGNUP=true

# Clipping limits
MAX_UPLOAD_MB=2048
MAX_SOURCE_MINUTES=180
MAX_CLIPS_PER_JOB=50
# Videos worked on at once: about 1 per 4 CPU cores given to the VM
CLIP_CONCURRENCY=1
# Clips of one video rendered side by side (0 = decide from the cores: 2 on 4 cores, 3 on 8, 4 on 16)
RENDER_PARALLEL=0
# Graphics card passed through to the VM? none · vaapi (Intel / AMD) · nvidia. See docs/PROXMOX.md.
GPU=none
# Set by deploy.sh from GPU; only change it to force one: libx264 · h264_vaapi · h264_qsv · h264_nvenc
# VIDEO_ENCODER=libx264
# Delete finished jobs and their clips after this many days (0 = never)
KEEP_JOBS_DAYS=7
X264_PRESET=veryfast
X264_CRF=22

# Trending: a YouTube Data API v3 key shows YouTube's real "most popular" chart (optional)
YOUTUBE_API_KEY=
TRENDING_REGION=US

# ── Social accounts: post clips to YouTube, TikTok, Instagram, Facebook, X, LinkedIn ──
# Each platform needs a (free) developer app; docs/SOCIAL.md walks through all six. Leave a pair empty
# and that platform simply shows as "not set up". Register this redirect address with each app:
#   <PUBLIC_URL>/api/v1/social/callback/<youtube|tiktok|instagram|facebook|x|linkedin>
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Encrypts the stored account tokens (generate with: openssl rand -hex 32). Keep it: changing it
# disconnects every account. Empty: derived from JWT_SECRET.
TOKEN_ENCRYPTION_KEY=
PUBLISH_CONCURRENCY=2

# ── Scout, edits and autopilot ── docs/AUTOPILOT.md
# YOUTUBE_API_KEY (above) gives Scout dates and subscriber counts. Twitch needs an app from dev.twitch.tv/console:
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Captions. "local" runs a Whisper container on this server (free; about 1 GB download on first use, CPU-heavy).
# Or leave CAPTIONS empty and point WHISPER_URL at a hosted service:
#   Groq:   WHISPER_URL=https://api.groq.com/openai/v1   WHISPER_MODEL=whisper-large-v3-turbo
#   OpenAI: WHISPER_URL=https://api.openai.com/v1        WHISPER_MODEL=whisper-1
CAPTIONS=
WHISPER_URL=
WHISPER_API_KEY=
WHISPER_MODEL=Systran/faster-whisper-small
# Claude writes hooks, titles, captions and hashtags, and can pick moments from what is said (console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── No public IP (home / office Proxmox)? Use a Cloudflare Tunnel instead of opening ports ──
# Create a tunnel at one.dash.cloudflare.com → Networks → Tunnels, point its public hostname at
# http://web:80, paste the token here, keep SITE_ADDRESS=:80 and set TRUST_PROXY=2.
TUNNEL_TOKEN=
TRUST_PROXY=1

# Database backups (written to deploy/backups by default)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=1
