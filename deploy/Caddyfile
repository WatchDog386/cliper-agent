# Cliper Agent reverse proxy.
# SITE_ADDRESS=clips.example.com  → automatic HTTPS via Let's Encrypt (recommended)
# SITE_ADDRESS=:80                → plain HTTP on the server IP (testing only)
{
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS::80} {
	# Caddy only compresses text-like responses by default (never video or zips)
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Thumbnails come from video sites (https images); clips play from our own /api/v1/media
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		-Server
	}

	# API: video uploads can be large
	handle /api/* {
		request_body {
			max_size {$MAX_UPLOAD_MB:2048}MB
		}
		reverse_proxy api:4000 {
			# Streams uploads and clip downloads without buffering them
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle /health {
		reverse_proxy api:4000
	}

	# Web app (Expo web build, single-page app)
	handle {
		@immutable path /_expo/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@mutable not path /_expo/static/*
		header @mutable Cache-Control "no-cache"
		root * /srv/web
		try_files {path} {path}.html /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
