# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# ── Database ──
DATABASE_URL=postgresql://cliper:cliper@localhost:5432/cliper_agent?schema=public

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Anyone may create an account (the first account becomes the admin). Set false once your team is in.
ALLOW_SIGNUP=true

# ── Clipping ──
STORAGE_DIR=storage
MAX_UPLOAD_MB=2048
MAX_SOURCE_MINUTES=180
MAX_CLIPS_PER_JOB=50
# Jobs rendered at the same time (each runs ffmpeg)
CLIP_CONCURRENCY=1
# Finished jobs and their clips are deleted after this many days (0 = keep forever)
KEEP_JOBS_DAYS=7
KEEP_SOURCE=false
X264_PRESET=veryfast
X264_CRF=22

# ── Video tools ──
# Leave empty to use backend/bin (npm run tools), the ffmpeg-static packages, or the programs on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
# Development only: allow links to localhost / private network addresses
ALLOW_PRIVATE_URLS=false

# ── Discover (trending) ──
# Optional YouTube Data API v3 key for the real trending chart. Without it, Discover uses search.
YOUTUBE_API_KEY=
TRENDING_REGION=US

# ── Production ──
# Number of reverse proxies in front of the API (1 behind Caddy)
TRUST_PROXY=0
LOGIN_RATE_LIMIT=30
API_RATE_LIMIT=600
